# Copy to terraform.tfvars and edit.  terraform.tfvars is git-ignored.

alert_email = "you@example.com"   # confirm the SNS email after `terraform apply`
aws_region  = "us-east-1"

# Cost vs availability
single_nat_gateway = true   # false = one NAT per AZ (~+$32/month)
db_multi_az        = true   # false = single-AZ RDS (cheaper, no automatic failover)

# Optional: custom domain + HTTPS (needs an existing public Route 53 hosted zone)
# domain_name      = "app.example.com"
# hosted_zone_name = "example.com"
